{
  "name": "cello",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:rscript-lookup": "node --experimental-strip-types --test server/findRscript.test.ts",
    "test:r-source-normalize": "node --experimental-strip-types --test server/normalizeRSource.test.ts",
    "test:flow-graph": "node --experimental-strip-types --test src/lib/flowGraph.test.ts",
    "test:explanation": "node --experimental-strip-types --test src/lib/explanation.test.ts",
    "test:project-file": "node --experimental-strip-types --test src/lib/projectFile.test.ts",
    "test:r-completions": "node --experimental-strip-types --test src/lib/rCompletions.test.ts",
    "test:highlight": "node --experimental-strip-types --test src/lib/highlight.test.ts",
    "test:server": "node --experimental-strip-types --test server/*.test.ts",
    "test": "npm run test:server && npm run test:flow-graph && npm run test:explanation && npm run test:project-file && npm run test:r-completions && npm run test:highlight"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "description": "Cello — a minimalist, cell-based development environment"
}
