{
  "name": "cello",
  "private": true,
  "version": "0.1.0",
  "description": "Cello — a minimalist, cell-based development environment",
  "author": "Cello contributors",
  "type": "module",
  "main": "electron/main.mjs",
  "allowScripts": {
    "electron": true,
    "esbuild": true
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop:install": "node scripts/ensure-electron.mjs",
    "predesktop": "npm run desktop:install",
    "desktop": "npm run build && electron .",
    "predesktop:app": "npm run desktop:install",
    "desktop:app": "electron .",
    "desktop:smoke": "npm run build && node electron/smoke-host.mjs",
    "desktop:bundle": "node scripts/bundle-electron-main.mjs",
    "desktop:dist:prepare": "npm run build && npm run desktop:bundle",
    "desktop:dist:win": "node scripts/dist-win.mjs",
    "desktop:dist:win:dir": "node scripts/dist-win.mjs --dir",
    "test:rscript-lookup": "node --experimental-strip-types --test server/findRscript.test.ts",
    "test:r-source-normalize": "node --experimental-strip-types --test server/normalizeRSource.test.ts",
    "test:flow-graph": "node --experimental-strip-types --test src/lib/flowGraph.test.ts",
    "test:explanation": "node --experimental-strip-types --test src/lib/explanation.test.ts",
    "test:project-file": "node --experimental-strip-types --test src/lib/projectFile.test.ts",
    "test:r-completions": "node --experimental-strip-types --test src/lib/rCompletions.test.ts",
    "test:highlight": "node --experimental-strip-types --test src/lib/highlight.test.ts",
    "test:panel-restore": "node --experimental-strip-types --test src/lib/panelRestore.test.ts",
    "test:desktop": "node --experimental-strip-types --test src/lib/desktop.test.ts",
    "test:settings": "node --experimental-strip-types --test src/lib/settings.test.ts",
    "test:server": "node --experimental-strip-types --test server/*.test.ts",
    "test": "npm run test:server && npm run test:flow-graph && npm run test:explanation && npm run test:project-file && npm run test:r-completions && npm run test:highlight && npm run test:panel-restore && npm run test:desktop && npm run test:settings"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.20.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
